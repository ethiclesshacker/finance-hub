<?xml version="1.0" encoding="UTF-8"?>
<!--
  Weekly and monthly retrospectives: Monday 00:10, and the 1st at 00:30.

  Both summarise the period that has *finished* — the previous week, the
  previous month — rather than the one containing the moment they run. Taking
  the period containing "now" made the weekly summary describe a week that was
  ten minutes old, and running monthly on the 28th silently dropped the last
  days of every month.

  Both read events directly rather than summarising the daily summaries, so a
  late-arriving email changes the next regeneration instead of being lost
  behind a copy of a copy.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.aadityavs.ledger.retrospective</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/aadityavs/projects/finance-hub &amp;&amp; npm run ledger:summarize -- --period week &amp;&amp; npm run ledger:summarize -- --period month</string>
  </array>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>0</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Day</key><integer>1</integer><key>Hour</key><integer>0</integer><key>Minute</key><integer>30</integer></dict>
  </array>

  <key>StandardOutPath</key>
  <string>/tmp/ledger-summary.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/ledger-summary.err</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
