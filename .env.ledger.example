# Personal Event Ledger — local job configuration.
# Copy to .env.ledger (gitignored). Loaded by the npm run ledger:* scripts,
# which read .env first and then this file.

# ── The only value you have to set ────────────────────
#
# Not a duplicate of VITE_SUPABASE_ANON_KEY. The anon key is subject to RLS and
# carries no session, so auth.uid() is null for a background job and every
# write is refused. The jobs write on your behalf with nobody signed in, which
# only the service role can do.
#
# It bypasses RLS entirely, which is why it lives here — gitignored, never read
# by a build, never inlined into the bundle (Vite only inlines VITE_* names).
#
# Supabase dashboard → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# ── Everything below is optional ──────────────────────

# The project URL comes from VITE_SUPABASE_URL in .env. Set this only to point
# the jobs somewhere else.
# SUPABASE_URL=

# Whose ledger the jobs write to. With one user in the project it is resolved
# automatically; set it only if there are several. `npm run ledger:users` lists them.
# LEDGER_USER_ID=

# Mail account passwords, if you prefer an env var to the macOS Keychain.
# Referenced by "password_env" in ledger/accounts.json.
# LEDGER_IMAP_PASSWORD_GMAIL=

# ── Extraction ────────────────────────────────────────
# Optional. Without a key the deterministic layers still produce a ledger and
# genuinely ambiguous mail lands in the review queue instead of being guessed at.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
LEDGER_LLM_ENABLED=true
# Extraction is mechanical — read the stated fields, fill the right slots — so
# thinking is off by default. Measured on real mail: identical results, 17%
# fewer tokens, 42% faster. Set to low / medium / high if a hard layout starts
# being misread.
OPENAI_REASONING_EFFORT=none

LEDGER_LLM_MAX_CALLS=25
LEDGER_LLM_BATCH_SIZE=5

# ── Nutrition ─────────────────────────────────────────
# Optional. Used only by `npm run ledger:nutrition`, and only for branded
# packaged goods — a barcode has a real label behind it, which beats any
# estimate. Composed restaurant dishes go to the model regardless; no food
# database contains "Paneer Do Pyaaza Mini Thali".
#
# Free, instant, no approval: https://fdc.nal.usda.gov/api-key-signup.html
# Without it that rung reports itself unconfigured and the ladder moves on.
# (Open Food Facts, the other database rung, needs no key.)
# FDC_API_KEY=

# ── Behaviour ─────────────────────────────────────────
LEDGER_TIMEZONE=Asia/Kolkata
LEDGER_MAX_MESSAGES=200
LEDGER_STORE_SNIPPETS=true
